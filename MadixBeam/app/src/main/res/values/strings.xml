    <!-- About -->
    <string name="about_title">About Madix Beam</string>
    <string name="about_body">Madix Beam transfers files between devices exclusively through animated QR codes. It requires no network connection and operates entirely offline, protecting each transfer with modern cryptography.</string>
    <string name="about_features">Capabilities</string>
    <string name="feature_offline_title">Fully offline</string>
    <string name="feature_offline_body">The application has no internet permission. Data travels only through the screen and the camera.</string>
    <string name="feature_e2e_title">End-to-end encryption</string>
    <string name="feature_e2e_body">Device pairing uses ephemeral ECDH P-256 key agreement and AES-256-GCM, confirmed by a six-digit verification code.</string>
    <string name="feature_fountain_title">Rateless fountain coding</string>
    <string name="feature_fountain_body">Frames can be received in any order. Missed frames are reconstructed from repair symbols without retransmission.</string>
    <string name="feature_integrity_title">Verified integrity</string>
    <string name="feature_integrity_body">Every encrypted chunk is authenticated and every file is checked against its SHA-256 digest.</string>
    <string name="feature_password_title">Password protection</string>
    <string name="feature_password_body">Passwords are strengthened with PBKDF2-HMAC-SHA-256 using 200,000 iterations.</string>
    <string name="feature_lock_title">Application lock</string>
    <string name="feature_lock_body">Biometric protection, screenshot prevention and private storage keep your transfers confidential.</string>
    <string name="about_technology">Technical specification</string>
    <string name="about_technology_body">Frames are Base45-encoded alphanumeric QR codes with CRC-32 validation. Payloads are compressed with DEFLATE when beneficial, sealed with chunked AES-256-GCM bound to the transfer header, and distributed with a systematic fountain code decoded by incremental Gaussian elimination.</string>
    <string name="about_licenses">Open-source components</string>
    <string name="about_copyright">© 2026 Madix. All rights reserved.</string>

    <!-- Privacy -->
    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_intro">This policy describes how Madix Beam handles information. Madix Beam is designed to operate without collecting any personal data.</string>
    <string name="privacy_section_data_title">Information collected</string>
    <string name="privacy_section_data_body">Madix Beam does not collect, store on remote servers, sell or share any personal information. The application contains no analytics, advertising or tracking components.</string>
    <string name="privacy_section_network_title">Network access</string>
    <string name="privacy_section_network_body">The application does not request internet access. Transfers take place exclusively between the screen of one device and the camera of another.</string>
    <string name="privacy_section_camera_title">Camera</string>
    <string name="privacy_section_camera_body">The camera is used only while scanning codes. Images are analysed in memory on the device and are never saved or transmitted.</string>
    <string name="privacy_section_storage_title">Stored data</string>
    <string name="privacy_section_storage_body">Received files and the transfer history are kept in the private storage of the application and are excluded from cloud backups. They can be deleted at any time from the settings.</string>
    <string name="privacy_section_security_title">Security</string>
    <string name="privacy_section_security_body">Encrypted transfers use keys that exist only in memory for the duration of a transfer. Optional app lock and screenshot protection provide additional safeguards.</string>
    <string name="privacy_section_contact_title">Contact</string>
    <string name="privacy_section_contact_body">Questions regarding this policy may be directed to the publisher through the contact details provided on the application store listing.</string>
    <string name="privacy_updated">Effective date: November 2026</string>

